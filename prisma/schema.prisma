generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Camera {
  id         Int         @id @default(autoincrement())
  name       String
  location   String?
  host       String?
  streamPath String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  recordings Recording[]
  snapshots  Snapshot[]
  events     Event[]
}

model Recording {
  id          Int       @id @default(autoincrement())
  cameraId    Int
  filename    String
  filePath    String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
  fileSize    BigInt?
  status      String    @default("recording")
  camera      Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Snapshot {
  id        Int      @id @default(autoincrement())
  cameraId  Int
  filename  String
  filePath  String
  createdAt DateTime @default(now())
  camera    Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
}

model Event {
  id        Int      @id @default(autoincrement())
  cameraId  Int?
  type      String
  message   String
  createdAt DateTime @default(now())
  camera    Camera?  @relation(fields: [cameraId], references: [id], onDelete: SetNull)
}
